# Prettier walks the whole tree unless told otherwise, and without this file
# `bun run lint` reports ~3,900 files — 3,624 of them build output under
# `src-tauri/`. The check was unrunnable long before anyone noticed.
#
# `.gitignore` is NOT consulted by Prettier, so anything ignored there that is
# still on disk has to be repeated here.

# Dependencies and build output
node_modules/
build/
.svelte-kit/
package/
.vercel/
coverage/

# Tauri: `target/` is Rust build output and `gen/` is generated; neither is ours
# to format. The hand-written `src-tauri/*.json`/`*.toml` are left in.
src-tauri/target/
src-tauri/gen/
# A bundled copy of the whole built app, shipped as the desktop sidecar.
src-tauri/resources/

# The database and uploaded files
data/

# Lockfiles are generated
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Generated by drizzle-kit; regenerating would undo any formatting anyway
drizzle/meta/

# Vendored/minified assets
static/opencv.js
*.min.js
*.traineddata

# Extracted archives and scratch
__MACOSX/
