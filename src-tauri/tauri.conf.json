{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Akaun",
  "version": "0.1.0",
  "identifier": "com.akaun.desktop",
  "build": {
    "frontendDist": "dist-stub",
    "beforeBuildCommand": "bun run build && bash scripts/prepare-desktop-sidecar.sh",
    "beforeDevCommand": "bun run build && bash scripts/prepare-desktop-sidecar.sh"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/sidecar/**/*"],
    "externalBin": ["binaries/bun"]
  }
}
